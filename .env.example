DATABASE_URL=postgres://localhost:5433/cab_platform
TEST_DATABASE_URL=postgres://localhost:5433/cab_platform_test
REDIS_URL=redis://localhost:6379
SITE_URL=http://localhost:3000
# Stays false until the client's lawyer confirms aggregator licensing (see plan §4).
AGGREGATOR_MODE=false
# Max vehicle age in years for eligibility. Draft 2025 rules said 9 [verify against final 2026 rules].
MAX_VEHICLE_AGE_YEARS=9
# Pages below this completeness score are noindex and excluded from the sitemap.
INDEX_COMPLETENESS_THRESHOLD=0.8
# Locales search engines may index. Add hi,mr after a native speaker reviews the translations.
INDEXABLE_LOCALES=en
# Business contact details for JSON-LD (the name is fixed: सनातन कार रेंटल). Leave unset until the client supplies real details;
# no LocalBusiness markup is emitted while any of these is missing.
# BUSINESS_PHONE=
# BUSINESS_STREET=
# BUSINESS_POSTCODE=
# WhatsApp number (digits, with country code) for click-to-chat buttons; hidden when unset.
# BUSINESS_WHATSAPP=

# --- e-Taxi assistant ---------------------------------------------------------------
# Without a key the offline engine answers (same tools, no LLM). Set both to use Claude.
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_NAME=e-Taxi
ASSISTANT_EFFORT=low
# Server-side refusal fallback ("fallbacks": "default"); on unless set to false.
ASSISTANT_REFUSAL_FALLBACK=true
ASSISTANT_IP_HOURLY_LIMIT=30
ASSISTANT_DAILY_TOKEN_CAP=2000000
ASSISTANT_HISTORY_TURNS=8

# --- WhatsApp Cloud API (webhook is 404 until all four are set) ----------------------
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=v23.0
